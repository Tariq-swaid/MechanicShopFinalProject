@using MechanicShop.Client.Hubs
@using System.Globalization
@implements IAsyncDisposable

<div class="position-relative" style="min-height: 65vh;">

    @if (_isLoading)
    {
        <div class="loading-overlay">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="loading-text">FETCHING DATA...</div>
        </div>
    }

    <header class="dashboard-header mb-4">
        <h3 class="fw-bold mb-1">Today's Overview</h3>
        <p class="lead text-muted fs-6">
            Live statistics for
            <span id="dashboardDate" class="fw-semibold text-primary">@data?.Date.ToString("MMMM dd, yyyy")</span>
        </p>
    </header>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-5 g-4 mb-4">
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-10 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Total Orders</h6>
                        <p class="dashboard-value">@data?.Total</p>
                    </div>
                    <div class="dashboard-icon text-secondary">
                        <i class="bi bi-list-ol"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-warning bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Scheduled</h6>
                        <p class="dashboard-value">@data?.Scheduled</p>
                    </div>
                    <div class="dashboard-icon text-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-info bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">In Progress</h6>
                        <p class="dashboard-value">@data?.InProgress</p>
                    </div>
                    <div class="dashboard-icon text-info">
                        <i class="bi bi-gear-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-success bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Completed</h6>
                        <p class="dashboard-value">@data?.Completed</p>
                    </div>
                    <div class="dashboard-icon text-success">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-danger bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Cancelled</h6>
                        <p class="dashboard-value">@data?.Cancelled</p>
                    </div>
                    <div class="dashboard-icon text-danger">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-4">
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Total Revenue</h6>
                        <p class="dashboard-value text-success">@FormatCurrency(data?.TotalRevenue ?? 0)</p>
                    </div>
                    <div class="dashboard-icon text-success">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Parts Cost</h6>
                        <p class="dashboard-value">@FormatCurrency(data?.TotalPartsCost ?? 0)</p>
                    </div>
                    <div class="dashboard-icon text-secondary">
                        <i class="bi bi-hammer"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Labor Cost</h6>
                        <p class="dashboard-value">@FormatCurrency(data?.TotalLaborCost ?? 0)</p>
                    </div>
                    <div class="dashboard-icon text-secondary">
                        <i class="bi bi-person-fill-gear"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Net Profit</h6>
                        <p class="dashboard-value text-primary">@FormatCurrency(data?.NetProfit ?? 0)</p>
                    </div>
                    <div class="dashboard-icon text-primary">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Unique Vehicles</h6>
                        <p class="dashboard-value">@data?.UniqueVehicles</p>
                    </div>
                    <div class="dashboard-icon text-secondary">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Unique Customers</h6>
                        <p class="dashboard-value">@data?.UniqueCustomers</p>
                    </div>
                    <div class="dashboard-icon text-secondary">
                        <i class="bi bi-person-lines-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Profit Margin</h6>
                        <p class="dashboard-value">@string.Format("{0:F2}%", data?.ProfitMargin ?? 0)</p>
                    </div>
                    <div class="dashboard-icon text-secondary">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Completion Rate</h6>
                        <p class="dashboard-value">@string.Format("{0:F2}%", data?.CompletionRate ?? 0)</p>
                    </div>
                    <div class="dashboard-icon text-secondary">
                        <i class="bi bi-clipboard-data-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Avg. Revenue/Order</h6>
                        <p class="dashboard-value">@FormatCurrency(data?.AverageRevenuePerOrder ?? 0)</p>
                    </div>
                    <div class="dashboard-icon text-secondary">
                        <i class="bi bi-graph-down-arrow"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Orders Per Vehicle</h6>
                        <p class="dashboard-value">@string.Format("{0:F2}", data?.OrdersPerVehicle ?? 0)</p>
                    </div>
                    <div class="dashboard-icon text-secondary">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Parts Cost Ratio</h6>
                        <p class="dashboard-value">@string.Format("{0:F2}%", data?.PartsCostRatio ?? 0)</p>
                    </div>
                    <div class="dashboard-icon text-secondary">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Labor Cost Ratio</h6>
                        <p class="dashboard-value">@string.Format("{0:F2}%", data?.LaborCostRatio ?? 0)</p>
                    </div>
                    <div class="dashboard-icon text-secondary">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card dashboard-card bg-secondary bg-opacity-25 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="dashboard-label text-uppercase fw-bold mb-2">Cancellation Rate</h6>
                        <p class="dashboard-value">@string.Format("{0:F2}%", data?.CancellationRate ?? 0)</p>
                    </div>
                    <div class="dashboard-icon text-secondary">
                        <i class="bi bi-dash-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject]
    private ServiceApi _serviceApi { get; set; } = default!;

    [Inject]
    private WorkOrderHubClient _hubClient { get; set; } = default!;

    private TodayWorkOrderStatsModel? data;

    // Added the loading boolean here!
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Start hub and bind callback
        await _hubClient.StartAsync(RefreshDashboard);

        // Initial data fetch
        await RefreshDashboard();
    }

    private string FormatCurrency(decimal amount)
    {
        return amount.ToString("C", CultureInfo.GetCultureInfo("en-us"));
    }

    private async Task RefreshDashboard()
    {
        // Turn on the loading glass effect
        _isLoading = true;
        await InvokeAsync(StateHasChanged);

        var statsData = await _serviceApi.GetTodayWorkOrderStatsAsync();

        if (statsData.IsSuccess)
        {
            data = statsData.Data;
        }

        // Turn off the loading glass effect
        _isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubClient is not null)
        {
            try
            {
                await _hubClient.DisposeAsync();
            }
            catch
            {
                // Intentionally swallowed
            }
        }
    }
}